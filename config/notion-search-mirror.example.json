{
  "outDir": "notion-sync-read-only",
  "workspaceFolder": "auto",
  "sync": {
    "intervalMinutes": 60
  },
  "report": {
    "retentionRuns": 250,
    "outputFile": ""
  },
  "limits": {
    "maxPages": 5000,
    "maxBlocksPerPage": 20000,
    "maxBlocksPerOutputFile": 500,
    "maxSecondsPerPage": 120,
    "maxMarkdownBytesPerPage": 5242880,
    "maxRunMinutes": 60
  },
  "searchIndex": {
    "provider": "qmd",
    "indexName": "openclaw-install-notion",
    "collectionName": "notion-mirror",
    "mcpServerName": "notion-search",
    "qmdCommand": "qmd",
    "embed": false,
    "noRerank": true,
    "freshnessFile": ".qmd-index-updated",
    "semantic": {
      "enabled": true,
      "provider": "fastembed",
      "model": "BAAI/bge-small-en-v1.5",
      "pythonCommand": ".fastembed-venv/bin/python",
      "indexPath": ".fastembed/notion-vectors.sqlite",
      "cacheDir": ".fastembed/model-cache",
      "chunkChars": 1800,
      "chunkOverlap": 200,
      "maxCharsPerFile": 12000,
      "batchSize": 64,
      "weight": 0.8
    }
  },
  "smoke": {
    "intervalMinutes": 60,
    "maxAgeHours": 24,
    "mainChannel": "main",
    "postCommand": ""
  },
  "syncScope": "integration-visible-workspace",
  "workspace": {
    "query": "",
    "pathPrefix": "",
    "limit": 5000
  },
  "pages": [],
  "databases": []
}
